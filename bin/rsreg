#!/usr/bin/env php
<?php

declare(strict_types=1);

foreach ([ __DIR__ . '/../../../autoload.php', __DIR__ . '/../vendor/autoload.php' ] as $autoloadFile) {
    if (\is_file($autoloadFile)) {
        require $autoloadFile;
        break;
    }
}

if (!\class_exists(\RNIDS\Cli\Application::class)) {
    \fwrite(STDERR, 'Unable to load the RSreg client. Run composer install first.' . PHP_EOL);
    exit(1);
}

$result = (new \RNIDS\Cli\Application())->run(\array_slice($argv, 1));
\fwrite(STDOUT, $result['stdout']);
\fwrite(STDERR, $result['stderr']);
exit($result['exitCode']);
